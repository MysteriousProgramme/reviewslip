# Nightly, and the thing you actually enable.

[Unit]
Description=Nightly reviewslip Postgres backup to S3

[Timer]
# 03:20 UTC. Off the hour on purpose: every cron job in the world runs at the
# top of one, and S3 and the box are both quieter in between.
OnCalendar=*-*-* 03:20:00 UTC

# Spread across ten minutes, so a fleet of these would not arrive together.
RandomizedDelaySec=10min

# If the box was off or rebooting at 03:20, run once it is back rather than
# skipping the night. Missing a backup because of a reboot is the most ordinary
# way to have a gap you did not know about.
Persistent=true

[Install]
WantedBy=timers.target
