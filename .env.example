# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
# Everything below except PORT can also be set in the Settings panel on the
# page (the gear, top right), which writes to `settings.json`. A value saved
# there wins over the value here, so `.env` is optional — it is just a handy
# way to seed a fresh install.

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Any model slug from https://openrouter.ai/models
# The slug is checked against OpenRouter's live catalogue — on boot, and again
# whenever you save it in Settings — so a typo is easy to spot.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Port to serve on. This one is .env only — changing it needs a restart anyway.
PORT=3000

# Where "Proceed to Google" sends the guest.
# Default is the Google Maps listing for Baanpong Lodge (CID form). Once the
# listing opens, the guest taps "Write a review".
#
# If the default ever stops resolving, these also work:
#   https://www.google.com/travel/search?q=baanpong%20lodge
#   https://search.google.com/local/writereview?placeid=<PLACE_ID>   (needs the ChIJ... place ID)
GOOGLE_REVIEW_URL=https://www.google.com/maps?cid=4269216131106280644
