# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# Subscribers live in SQLite (data/app.db), one row per venue, and each one
# holds its own key, model, review link and website. The values below are the
# fallback underneath them: a venue that has not set a field of its own uses
# what is here. So a platform key set here works for every venue, and a venue
# that brings its own key simply overrides it.

# ---------------------------------------------------------------- platform --

# Guards the admin API (/api/admin/*), which creates and manages subscribers.
# Without it the admin API refuses to answer at all. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# The domain subscriber subdomains hang off. `baanpong.reviews.example` then
# serves the subscriber with slug `baanpong`.
#
# Leave it as localhost for development — browsers resolve every *.localhost
# name to the loopback address on their own, so http://baanpong.localhost:3000
# works with no DNS and no hosts-file editing. In production this needs a
# wildcard DNS record (*.reviews.example) and a wildcard TLS certificate.
BASE_DOMAIN=localhost

# Port to serve on. Changing it needs a restart anyway, so it is .env only.
PORT=3000

# Optional. Any hostname that does not match a subscriber falls back to this
# slug — handy for running a single venue with no DNS at all. Leave empty to
# have unmatched hosts say so instead.
DEFAULT_SUBSCRIBER=

# Optional. Set when running behind nginx, Caddy, Cloudflare and so on, so the
# guest's real hostname and address are read from X-Forwarded-* instead of the
# proxy's. Accepts `true`, a hop count like `1`, or `loopback`. Leave empty
# when the app faces the internet directly — trusting those headers otherwise
# lets a client pick its own subscriber and dodge the throttle.
TRUST_PROXY=

# Optional. Where the SQLite file lives. Defaults to ./data/app.db.
DB_FILE=

# ------------------------------------------------- fallbacks for all venues --

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model slug from https://openrouter.ai/models
# The slug is checked against OpenRouter's live catalogue — on boot, and again
# whenever it is saved — so a typo is easy to spot.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Where "Proceed to Google" sends the guest, for venues with no link of their
# own. Usually left empty: a review link is per venue almost by definition.
#
# The Maps CID form works well. Once the listing opens, the guest taps
# "Write a review". These also work:
#   https://www.google.com/travel/search?q=<venue%20name>
#   https://search.google.com/local/writereview?placeid=<PLACE_ID>
GOOGLE_REVIEW_URL=

# Same, for the Tripadvisor listing. A venue with neither link set gets no
# Proceed button at all — writing still works, posting has nowhere to go.
TRIPADVISOR_REVIEW_URL=

# A venue's own website, read once in Settings to draft the venue details.
# Guests never see it. Also usually per venue rather than set here.
VENUE_WEBSITE_URL=
